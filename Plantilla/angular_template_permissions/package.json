{
  "name": "angularstarterkit",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200 --configuration=local",
    "start:ng": "ng serve --port 4200",
    "serve": "ng serve --port 4200 --ssl --ssl-key src/certs/key.pem --ssl-cert src/certs/cert.pem",
    "serve:local": "ng serve --port 4200 --ssl=false --configuration=local",
    "serve:lab": "ng serve --port 4200 --ssl --ssl-key src/certs/key.pem --ssl-cert src/certs/cert.pem --configuration=lab",
    "serve:uat": "ng serve --port 4200 --ssl=false --configuration=uat",
    "serve:prod": "ng serve --port 4200 --ssl=false --configuration=production",
    "build": "ng build",
    "build-local": "ng build --configuration=local",
    "build-uat": "ng build --configuration=uat",
    "build-prod": "ng build --configuration=production",
    "test": "ng test",
    "e2e": "playwright test",
    "lint": "ng lint",
    "create-localhost-certificate": "mkcert -key-file src/certs/key.pem -cert-file src/certs/cert.pem localhost"
  },
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/cdk": "^20.2.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/material": "^20.2.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "^20.3.0",
    "@azure/msal-angular": "^4.0.0",
    "@azure/msal-browser": "^4.0.0",
    "@ngrx/data": "^20.0.0",
    "@ngrx/effects": "^20.0.0",
    "@ngrx/entity": "^20.0.0",
    "@ngrx/router-store": "^20.0.0",
    "@ngrx/store": "^20.0.0",
    "@ngrx/store-devtools": "^20.0.0",
    "@ngx-pwa/local-storage": "^20.0.0",
    "@ngx-translate/core": "^18.1.0",
    "@ngx-translate/http-loader": "^18.1.0",
    "@primeuix/themes": "^1.0.0",
    "animate.css": "^4.1.1",
    "ngx-device-detector": "^10.1.0",
    "ngx-json-viewer": "^3.2.1",
    "ngx-logger": "^5.0.12",
    "ngx-permissions": "^19.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.0.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.0",
    "@angular-eslint/builder": "^20.0.0",
    "@angular-eslint/eslint-plugin": "^20.0.0",
    "@angular-eslint/eslint-plugin-template": "^20.0.0",
    "@angular-eslint/schematics": "^20.0.0",
    "@angular-eslint/template-parser": "^20.0.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/language-service": "^20.3.0",
    "@playwright/test": "^1.56.0",
    "@types/jasmine": "^5.1.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^9.0.0",
    "jasmine-core": "^5.0.0",
    "karma": "^6.4.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "sass": "^1.80.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  }
}
